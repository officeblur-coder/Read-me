# Conexiunea aplicației (rol fără BYPASSRLS — izolarea multi-tenant este impusă de PostgreSQL)
DATABASE_URL=postgres://autoflow_app:autoflow_app_dev@localhost:5432/autoflow
# Conexiune folosită doar pentru migrații (proprietarul tabelelor)
DATABASE_OWNER_URL=postgres://autoflow_owner:autoflow_owner_dev@localhost:5432/autoflow
# Director pentru fotografii în dezvoltare (în producție: driver S3)
STORAGE_DIR=./storage
